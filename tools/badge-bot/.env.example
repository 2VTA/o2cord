# Copy this file to .env and fill in real values.
# .env is git-ignored - it never gets committed.

# Discord bot token, from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_BOT_TOKEN=

# The Discord server (guild) ID the bot is allowed to respond in. Everything
# outside this server - including DMs - is ignored.
ALLOWED_GUILD_ID=

# Your own Discord user ID. Only messages from this user are processed.
ALLOWED_USER_ID=719085334989897750

# GitHub Fine-grained Personal Access Token, scoped to the 2VTA/o2cord repo
# only, with "Contents: Read and write" permission.
GITHUB_TOKEN=
